---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import Showrooms from '../components/Showrooms.astro';
import { SITE } from '../lib/site';
import { whatsappUrl } from '../lib/equipos';

const equipoParam = Astro.url.searchParams.get('equipo') || '';
const wa = whatsappUrl('Hola Alta Qualità, quiero agendar una demo desde /contacto.');

const faq = [
  {
    q: '¿Cómo agendo una demo?',
    a: 'Completa el formulario con nombre, clínica, ciudad, equipo de interés, teléfono y correo. También puedes visitar un showroom en Vitacura, Concón o Los Ángeles, o escribir por WhatsApp.',
  },
  {
    q: '¿Dónde están los showrooms?',
    a: 'Vitacura: Los Abedules 3085. Concón: Las Pelargonias 843, Oficina 1112. Los Ángeles: Av. Gabriela Mistral 269. Agenda la visita desde este formulario indicando la ciudad.',
  },
  {
    q: '¿La demo tiene costo?',
    a: 'Las condiciones de la demo (presencial en showroom, en clínica o remota) se confirman al coordinar. No se publica un cobro inventado.',
  },
  {
    q: '¿Puedo cotizar varios equipos?',
    a: 'Sí. En el campo «equipo de interés» elige «Varios / aún no sé» o indícalo en el seguimiento.',
  },
  {
    q: '¿Cuál es el correo y teléfono de Alta Qualità?',
    a: `Correo ${SITE.email}. Teléfono y WhatsApp ${SITE.phone}. Razón social: ${SITE.legalName}, RUT ${SITE.rut}.`,
  },
];
---

<Layout
  title="Contacto — agendar demo y cotizar"
  description="Agenda una demo en showroom Vitacura, Concón o Los Ángeles, o cotiza equipos Alta Qualità. Formulario de 6 campos."
>
  <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Contacto' }]} />

  <section class="container-aq pb-8 pt-6">
    <p class="eyebrow mb-2">Contacto</p>
    <h1 class="mb-4">Agendar demo / cotizar</h1>
    <p class="prose-aq text-sm">
      Seis campos. Validación en línea. Sin bloquear la descarga de fichas técnicas.
      Puedes agendar en cualquiera de los tres showrooms.
    </p>
  </section>

  <section class="container-aq grid gap-10 pb-12 lg:grid-cols-2">
    <LeadForm defaultEquipo={equipoParam} sourcePage="/contacto" />

    <div>
      <h2 class="mb-4">Otros canales</h2>
      <ul class="space-y-3 text-sm">
        <li class="flex flex-wrap items-center gap-2">
          <span class="label-mono">Correo</span>
          <a href={`mailto:${SITE.email}`} class="link-text">{SITE.email}</a>
        </li>
        <li class="flex flex-wrap items-center gap-2">
          <span class="label-mono">Teléfono</span>
          <a href={`tel:${SITE.phone}`} class="link-text">{SITE.phone}</a>
        </li>
        <li class="flex flex-wrap items-center gap-2">
          <span class="label-mono">WhatsApp</span>
          {wa && (
            <a href={wa} class="link-text" target="_blank" rel="noopener noreferrer" data-wa>
              Abrir chat
            </a>
          )}
        </li>
        <li class="pt-2 font-mono text-[10px] uppercase tracking-[0.06em] text-acero">
          {SITE.legalName} · RUT {SITE.rut}
        </li>
      </ul>
      <p class="mt-8 text-xs text-acero">
        Última actualización de esta página: {SITE.lastUpdated}
      </p>
    </div>
  </section>

  <section class="border-y border-linea bg-papel py-14" aria-labelledby="showrooms-title">
    <div class="container-aq">
      <p class="eyebrow mb-2">Presencia en Chile</p>
      <h2 id="showrooms-title" class="mb-6">Showrooms</h2>
      <Showrooms />
    </div>
  </section>

  <FAQ items={faq} />
</Layout>

<script>
  document.querySelector('[data-wa]')?.addEventListener('click', () => {
    // @ts-expect-error
    if (typeof window.gtag === 'function') window.gtag('event', 'click_whatsapp', { page_path: '/contacto' });
  });
</script>
