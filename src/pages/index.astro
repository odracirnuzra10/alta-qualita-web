---
import Layout from '../layouts/Layout.astro';
import SpecRow from '../components/SpecRow.astro';
import ProductMedia from '../components/ProductMedia.astro';
import FAQ from '../components/FAQ.astro';
import ClineraBanner from '../components/ClineraBanner.astro';
import { getEquipos, formatCLP, priceParts, hasPrice, pricedEquipos } from '../lib/equipos';

const equipos = getEquipos();
const catalogCount = String(equipos.length);
const priced = pricedEquipos();
const minPrice = priced.length ? Math.min(...priced.map((e) => e.priceNeto)) : 0;
const maxPrice = priced.length ? Math.max(...priced.map((e) => e.priceNeto)) : 0;
const minName = priced.find((e) => e.priceNeto === minPrice)?.name ?? '';
const maxName = priced.find((e) => e.priceNeto === maxPrice)?.name ?? '';
const heroImage = equipos.find((e) => e.slug === 'ized')?.image
  ?? equipos.find((e) => e.image)?.image
  ?? null;

const comparadorHome = equipos.filter((e) =>
  ['ized', 'corpolift', 'skinwave-max', 'sculpt-dd'].includes(e.slug)
);

const homeFaq = [
  {
    q: '¿Cuánto cuestan los equipos de estética de Alta Qualità en Chile?',
    a: `Todos los precios son neto + IVA 19%. Van desde $${formatCLP(minPrice)} (${minName}) hasta $${formatCLP(maxPrice)} (${maxName}). Cada ficha muestra neto, IVA y total. Ejemplo: SkinWave Max = $4.500.000 neto + $855.000 IVA = $5.355.000 total.`,
  },
  {
    q: '¿Los equipos son italianos o coreanos?',
    a: 'Son de origen coreano. El nombre Alta Qualità es italiano, pero los equipos se fabrican en Corea del Sur. El origen se declara abiertamente en cada ficha.',
  },
  {
    q: '¿Puedo descargar la ficha técnica sin dejar mis datos?',
    a: 'Sí. Las fichas PDF se descargan sin formulario. El lead se captura al agendar demo o cotizar, nunca bloqueando el dato técnico.',
  },
  {
    q: '¿Qué es Clinera.io y por qué viene con el equipo?',
    a: 'Clinera.io es software con IA para clínicas (agendamiento WhatsApp, voz y reportes). Por cada equipo comprado en Alta Qualità: implementación gratis (USD 450 → $0) y 3 meses con 50% de descuento, implementado por el mismo equipo de ingenieros.',
  },
  {
    q: '¿Alta Qualità vende a clínicas en todo Chile?',
    a: 'Sí. Alta Qualità vende a clínicas estéticas, centros médico-estéticos y profesionales independientes en Chile. Tiene showrooms en Vitacura (Los Abedules 3085), Concón (Las Pelargonias 843, Of. 1112) y Los Ángeles (Av. Gabriela Mistral 269).',
  },
  {
    q: '¿Dónde veo garantía, repuestos y soporte?',
    a: 'En /soporte-tecnico y en cada ficha. Garantía: 12 meses. SLA de primera respuesta: 48 horas. Repuestos en stock en Chile y capacitación incluida.',
  },
  {
    q: '¿Cómo comparo varios equipos antes de comprar?',
    a: 'Usa el comparador en /comparador: tabla HTML con precio neto, IVA, total y campos técnicos lado a lado. Los datos faltantes se muestran vacíos, sin inventar cifras.',
  },
  {
    q: '¿Cómo calculo en cuántos meses se paga un equipo?',
    a: 'En /retorno: precio de sesión × sesiones al mes ÷ inversión neta. Los supuestos quedan visibles y editables.',
  },
];

const heroSpecs = [
  { label: 'Equipos en catálogo', value: catalogCount },
  { label: 'Origen', value: 'Corea del Sur' },
  { label: 'Garantía (meses)', value: '12' },
  { label: 'Soporte (horas)', value: '48' },
];
---

<Layout
  title="Equipos de estética profesional coreanos en Chile"
  description="Alta Qualità importa equipos de estética profesional de origen coreano a Chile. Precios netos + IVA visibles, fichas técnicas descargables y oferta Clinera.io (implementación gratis + 3 meses al 50%)."
>
  <!-- 1. Hero -->
  <section class="border-b border-linea">
    <div class="container-aq grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-16">
      <div>
        <p class="eyebrow mb-3">Equipos de estética · Origen: Corea del Sur</p>
        <h1 class="mb-5">
          Datos técnicos completos para decidir una compra de alto ticket
        </h1>
        <p class="prose-aq mb-8 text-base">
          Alta Qualità importa equipos de estética profesional coreanos para clínicas,
          centros médico-estéticos y profesionales independientes en Chile.
          <strong>Todos los precios son neto + IVA.</strong> Repuestos en Chile.
          Showrooms en Vitacura, Concón y Los Ángeles para ver las máquinas antes de comprar.
        </p>
        <SpecRow specs={heroSpecs} class="mb-8" />
        <div class="flex flex-wrap gap-3">
          <a href="/contacto" class="btn-primary" data-track="agendar_demo">Agendar demo en showroom</a>
          <a href="/equipos" class="btn-secondary">Ver catálogo</a>
          <a href="/skinwave-max" class="btn-ghost" data-track="skinwave_hero">SkinWave Max</a>
        </div>
      </div>
      <ProductMedia name="iZED" image={heroImage} fig="FIG. 01" priority />
    </div>
  </section>

  <!-- SkinWave Max destacado -->
  <section class="home-ized" aria-labelledby="home-swm-title">
    <div class="container-aq home-ized__grid">
      <div>
        <p class="eyebrow mb-2">HIFU facial · Corea del Sur</p>
        <p class="home-ized__brand">SkinWave Max</p>
        <h2 id="home-swm-title" class="mb-4 text-2xl sm:text-3xl">
          HIFU facial coreano certificado — verlo en showroom
        </h2>
        <p class="prose-aq mb-6 max-w-[46ch] text-sm">
          Lifting no invasivo a 1,5 / 3,0 / 4,5&nbsp;mm. Cartuchos con 14.000 disparos (+40%).
          $4.500.000 neto + IVA. Repuestos en Chile. Agenda demo en Vitacura, Concón o Los Ángeles.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/skinwave-max" class="btn-primary" data-track="skinwave_home">
            Ver SkinWave Max
          </a>
          <a
            href="/recursos/que-es-skinwave-max-hifu-facial-coreano-chile"
            class="btn-secondary"
            data-track="guia_skinwave_home"
          >
            Leer guía HIFU
          </a>
        </div>
      </div>
      <a href="/skinwave-max" class="home-ized__media no-underline" aria-label="Abrir landing SkinWave Max">
        <img
          src="/img/equipos/skinwave-max.webp"
          alt="SkinWave Max HIFU facial coreano"
          width="840"
          height="840"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <!-- Guía iZED destacada -->
  <section class="home-ized" aria-labelledby="home-ized-title">
    <div class="container-aq home-ized__grid">
      <div>
        <p class="eyebrow mb-2">Guía destacada</p>
        <p class="home-ized__brand">iZED</p>
        <h2 id="home-ized-title" class="mb-4 text-2xl sm:text-3xl">
          Ultrasonido focalizado para contorno corporal
        </h2>
        <p class="prose-aq mb-6 max-w-[46ch] text-sm">
          Qué es iZED, cómo funciona a 60 joules según el fabricante, en qué se diferencia
          de HIEMT y criolipólisis, y cuánto cuesta en Chile — con fotos del equipo.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/recursos/que-es-ized-ultrasonido-focalizado-chile"
            class="btn-primary"
            data-track="guia_ized_home"
          >
            Leer guía iZED
          </a>
          <a href="/equipos/ized" class="btn-secondary">Ver ficha y precio</a>
        </div>
      </div>
      <a
        href="/recursos/que-es-ized-ultrasonido-focalizado-chile"
        class="home-ized__media no-underline"
        aria-label="Abrir guía iZED"
      >
        <img
          src="/img/equipos/ized.webp"
          alt="Equipo iZED de ultrasonido focalizado"
          width="840"
          height="840"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <!-- 3. Catálogo -->
  <section class="py-16" aria-labelledby="catalogo-title">
    <div class="container-aq">
      <p class="eyebrow mb-2">Catálogo</p>
      <h2 id="catalogo-title" class="mb-3">{catalogCount} equipos. Precio neto + IVA a la vista.</h2>
      <p class="prose-aq mb-10 text-sm">
        Cada ficha muestra origen coreano, precio en formato chileno y campos técnicos.
        Lo que falta aparece como «por confirmar» — nunca inventado.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          equipos.map((e) => {
            const pricedRow = hasPrice(e.priceNeto);
            const p = pricedRow ? priceParts(e.priceNeto) : null;
            return (
              <a href={e.slug === 'skinwave-max' ? '/skinwave-max' : `/equipos/${e.slug}`} class="card-line group block overflow-hidden no-underline transition-colors hover:border-grafito">
                {e.image ? (
                  <img
                    src={e.image}
                    alt=""
                    width="600"
                    height="600"
                    class="aspect-square w-full object-cover bg-papel"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
                <div class="p-4">
                  <p class="label-mono mb-2">{e.category}</p>
                  <h3 class="mb-3 text-xl group-hover:text-cobalto">{e.name}</h3>
                  <p class="font-mono text-sm font-medium text-grafito" style="font-variant-numeric: tabular-nums;">
                    {pricedRow ? `$${formatCLP(e.priceNeto)} neto` : 'Consultar precio'}
                  </p>
                  <p class="mt-1 font-mono text-[10px] tracking-[0.04em] text-acero">
                    {p ? `${p.ivaLabel} · ${p.totalLabel}` : 'Precio a cotizar'}
                  </p>
                  <p class="mt-4 text-sm text-cobalto">Ver ficha →</p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 4. Clinera — banner de marca Clinera (rompe visualmente con AQ) -->
  <ClineraBanner />

  <!-- 5. Comparador resumido -->
  <section class="py-16" aria-labelledby="comp-title">
    <div class="container-aq">
      <p class="eyebrow mb-2">Comparador</p>
      <h2 id="comp-title" class="mb-3">¿Qué equipo comparar primero?</h2>
      <p class="prose-aq mb-8 text-sm">Tabla real HTML para extracción por buscadores e IA.</p>
      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr>
              <th scope="col">Equipo</th>
              <th scope="col">Categoría</th>
              <th scope="col">Neto</th>
              <th scope="col">IVA 19%</th>
              <th scope="col">Total</th>
              <th scope="col">Origen</th>
            </tr>
          </thead>
          <tbody>
            {
              comparadorHome.map((e) => {
                const pricedRow = hasPrice(e.priceNeto);
                const p = pricedRow ? priceParts(e.priceNeto) : null;
                return (
                  <tr>
                    <td>
                      <a href={e.slug === 'skinwave-max' ? '/skinwave-max' : `/equipos/${e.slug}`} class="link-text font-medium">
                        {e.name}
                      </a>
                    </td>
                    <td>{e.category}</td>
                    <td class="font-mono text-cobalto font-medium">{hasPrice(e.priceNeto) ? `$${formatCLP(e.priceNeto)}` : 'Consultar'}</td>
                    <td class="font-mono">{p ? `$${formatCLP(p.iva)}` : '—'}</td>
                    <td class="font-mono">{p ? `$${formatCLP(p.total)}` : '—'}</td>
                    <td>{e.origin}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <a href="/comparador" class="btn-secondary mt-6 inline-flex" data-track="ver_comparador">Abrir comparador completo</a>
    </div>
  </section>

  <!-- 6. Soporte -->
  <section class="border-y border-linea py-16" aria-labelledby="soporte-title">
    <div class="container-aq grid gap-8 lg:grid-cols-2">
      <div>
        <p class="eyebrow mb-2">Soporte y garantía</p>
        <h2 id="soporte-title">El argumento que más pesa en la decisión</h2>
        <p class="prose-aq mt-4 text-sm">
          En compras de $5 a $17 millones, el comprador pregunta por repuestos en Chile,
          plazos de garantía y tiempo de respuesta. Publicamos lo confirmado; lo demás
          queda visible como pendiente.
        </p>
        <a href="/soporte-tecnico" class="btn-secondary mt-6 inline-flex">Ver soporte técnico</a>
      </div>
      <ul class="grid gap-3">
        {['Garantía 12 meses', 'Repuestos en stock en Chile', 'SLA de primera respuesta: 48 horas', 'Capacitación incluida'].map((t) => (
          <li class="border border-linea bg-papel px-4 py-3 font-mono text-xs uppercase tracking-[0.04em] text-grafito">{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. Retorno -->
  <section class="py-16" aria-labelledby="roi-title">
    <div class="container-aq max-w-3xl">
      <p class="eyebrow mb-2">Retorno</p>
      <h2 id="roi-title">¿En cuántos meses se paga el equipo?</h2>
      <p class="prose-aq mt-4 text-sm">
        Calcula con precio de sesión y volumen mensual. Supuestos a la vista, editables,
        sin cifras de marketing inventadas.
      </p>
      <a href="/retorno" class="btn-primary mt-6 inline-flex">Abrir calculadora</a>
    </div>
  </section>

  <FAQ items={homeFaq} />

  <!-- 9. CTA final -->
  <section class="border-t border-linea bg-grafito py-16 text-blanco">
    <div class="container-aq text-center">
      <h2 class="!text-blanco">Agenda una demo con datos sobre la mesa</h2>
      <p class="mx-auto mt-4 max-w-[60ch] text-sm text-white/75">
        Lleva la ficha técnica, el precio neto + IVA y las preguntas de garantía.
        Sin testimonios inventados. Sin specs inventadas.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/contacto" class="btn-cobalto">Agendar demo</a>
        <a href="/equipos" class="btn border border-white/40 text-blanco hover:bg-white/10">Ver catálogo</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('[data-track]').forEach((el) => {
    el.addEventListener('click', () => {
      const name = (el as HTMLElement).dataset.track;
      // @ts-expect-error
      if (name && typeof window.gtag === 'function') window.gtag('event', name, { page_path: location.pathname });
    });
  });
</script>
