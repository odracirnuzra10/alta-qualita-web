---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceDisplay from '../../components/PriceDisplay.astro';
import { getEquipos, formatCLP, priceParts, hasPrice, pricedEquipos } from '../../lib/equipos';

const equipos = getEquipos();
const count = equipos.length;
const priced = pricedEquipos();
const minPrice = priced.length ? Math.min(...priced.map((e) => e.priceNeto)) : 0;
---

<Layout
  title="Catálogo de equipos de estética coreanos en Chile"
  description={`Catálogo completo Alta Qualità: ${count} equipos de estética profesional de origen coreano.${minPrice ? ` Precios netos desde $${minPrice.toLocaleString('es-CL')} + IVA.` : ''} Fichas técnicas descargables.`}
>
  <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Equipos' }]} />

  <section class="container-aq pb-16 pt-6">
    <p class="eyebrow mb-2">Catálogo completo</p>
    <h1 class="mb-4">Equipos de estética profesional</h1>
    <p class="prose-aq mb-10 text-sm">
      {count} equipos importados desde Corea del Sur. Precio neto, IVA 19% y total visibles
      en cada ficha publicada. Specs o precios vacíos = «por confirmar», nunca inventados.
    </p>

    <div class="overflow-x-auto mb-12">
      <table>
        <thead>
          <tr>
            <th scope="col">Equipo</th>
            <th scope="col">Categoría</th>
            <th scope="col">Neto</th>
            <th scope="col">IVA</th>
            <th scope="col">Total</th>
            <th scope="col">Origen</th>
            <th scope="col">Ficha</th>
          </tr>
        </thead>
        <tbody>
          {
            equipos.map((e) => {
              const pricedRow = hasPrice(e.priceNeto);
              const p = pricedRow ? priceParts(e.priceNeto) : null;
              return (
                <tr>
                  <th scope="row" class="!bg-blanco !normal-case !tracking-normal !text-sm !font-sans font-semibold text-grafito">
                    {e.name}
                  </th>
                  <td>{e.category}</td>
                  <td class="font-mono text-cobalto font-medium">{pricedRow ? `$${formatCLP(e.priceNeto)}` : 'Consultar'}</td>
                  <td class="font-mono">{p ? `$${formatCLP(p.iva)}` : '—'}</td>
                  <td class="font-mono">{p ? `$${formatCLP(p.total)}` : '—'}</td>
                  <td>{e.origin}</td>
                  <td><a href={`/equipos/${e.slug}`} class="link-text">Ver</a></td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        equipos.map((e) => (
          <a href={`/equipos/${e.slug}`} class="card-line block overflow-hidden no-underline hover:border-grafito">
            {e.image ? (
              <img
                src={e.image}
                alt=""
                width="600"
                height="600"
                class="aspect-square w-full object-cover bg-papel"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <div class="p-5">
              <p class="label-mono mb-2">{e.category}</p>
              <h2 class="!text-2xl mb-3">{e.name}</h2>
              <PriceDisplay neto={e.priceNeto} />
              <p class="mt-4 text-sm text-cobalto">Abrir ficha técnica →</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
