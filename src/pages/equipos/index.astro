---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EquipoCard from '../../components/EquipoCard.astro';
import AvailabilityBadge from '../../components/AvailabilityBadge.astro';
import { getEquipos, getEquiposPorDisponibilidad, formatCLP, priceParts, hasPrice, pricedEquipos } from '../../lib/equipos';

const { stock: equiposStock, pedido: equiposPedido } = getEquiposPorDisponibilidad();
const equipos = [...equiposStock, ...equiposPedido];
const count = getEquipos().length;
const priced = pricedEquipos();
const minPrice = priced.length ? Math.min(...priced.map((e) => e.priceNeto)) : 0;
---

<Layout
  title="Catálogo de equipos de estética coreanos en Chile"
  description={`Catálogo completo Alta Qualità: ${count} equipos de estética profesional de origen coreano.${minPrice ? ` Precios netos desde $${minPrice.toLocaleString('es-CL')} + IVA.` : ''} Fichas técnicas descargables.`}
>
  <Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Equipos' }]} />

  <section class="container-aq pb-16 pt-6">
    <p class="eyebrow mb-2">Catálogo completo</p>
    <h1 class="mb-4">Equipos de estética profesional</h1>
    <p class="prose-aq mb-10 text-sm">
      {count} equipos importados desde Corea del Sur: {equiposStock.length} en stock en Chile y {equiposPedido.length} a pedido (30 días). Precio neto, IVA 19% y total visibles
      en cada ficha publicada. Specs o precios vacíos = «por confirmar», nunca inventados.
    </p>

    <div class="overflow-x-auto mb-12">
      <table>
        <thead>
          <tr>
            <th scope="col">Equipo</th>
            <th scope="col">Disponibilidad</th>
            <th scope="col">Categoría</th>
            <th scope="col">Neto</th>
            <th scope="col">IVA</th>
            <th scope="col">Total</th>
            <th scope="col">Origen</th>
            <th scope="col">Ficha</th>
          </tr>
        </thead>
        <tbody>
          {
            equipos.map((e) => {
              const pricedRow = hasPrice(e.priceNeto);
              const p = pricedRow ? priceParts(e.priceNeto) : null;
              return (
                <tr>
                  <th scope="row" class="!bg-blanco !normal-case !tracking-normal !text-sm !font-sans font-semibold text-grafito">
                    {e.name}
                  </th>
                  <td><AvailabilityBadge disponibilidad={e.disponibilidad} size="sm" /></td>
                  <td>{e.category}</td>
                  <td class="font-mono text-cobalto font-medium">{pricedRow ? `$${formatCLP(e.priceNeto)}` : 'Consultar'}</td>
                  <td class="font-mono">{p ? `$${formatCLP(p.iva)}` : '—'}</td>
                  <td class="font-mono">{p ? `$${formatCLP(p.total)}` : '—'}</td>
                  <td>{e.origin}</td>
                  <td><a href={`/equipos/${e.slug}`} class="link-text">Ver</a></td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <div id="entrega-inmediata" class="mb-14" aria-labelledby="stock-title">
      <h2 id="stock-title" class="mb-2">Entrega inmediata</h2>
      <p class="prose-aq mb-6 text-sm">En stock en Chile. Instalación y capacitación en nuestros showrooms.</p>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {equiposStock.map((e) => <EquipoCard equipo={e} variant="stock" />)}
      </div>
    </div>

    <div id="a-pedido" class="border-t border-linea pt-10" aria-labelledby="pedido-title">
      <h2 id="pedido-title" class="!text-xl mb-1 !font-semibold">A pedido</h2>
      <p class="mb-5 text-sm text-acero">Importación directa. Entrega en 30 días.</p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {equiposPedido.map((e) => <EquipoCard equipo={e} variant="pedido" />)}
      </div>
    </div>
  </section>
</Layout>
