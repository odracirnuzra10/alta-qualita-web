---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import JsonLd from '../../components/JsonLd.astro';
import { guias, getGuia } from '../../lib/recursos';
import { guiaBodies } from '../../lib/guias-content';
import { getEquipo, formatCLP, hasPrice } from '../../lib/equipos';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return guias.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guia = getGuia(slug!);
if (!guia) throw new Error(`Guía no encontrada: ${slug}`);

const body = guiaBodies[guia.slug] || '<p>Contenido en preparación.</p>';
const related = guia.relatedEquipos.map((s) => getEquipo(s)).filter(Boolean);
const isVisual = Boolean(guia.cover);

function formatDate(iso: string) {
  return new Date(iso + 'T12:00:00').toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guia.title,
  description: guia.description,
  datePublished: guia.published,
  dateModified: guia.updated,
  inLanguage: 'es-CL',
  ...(guia.cover ? { image: `${SITE.domain}${guia.cover.src}` } : {}),
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
  mainEntityOfPage: `${SITE.domain}/recursos/${guia.slug}`,
};

const faqItems = guia.faq.map((f) => ({ q: f.q, a: f.a }));
---

<Layout
  title={guia.title}
  description={guia.description}
  dateModified={guia.updated}
  ogImage={guia.cover?.src}
>
  <JsonLd data={articleLd} slot="head" />

  <Breadcrumbs
    items={[
      { name: 'Inicio', href: '/' },
      { name: 'Recursos', href: '/recursos' },
      { name: guia.brand || guia.title },
    ]}
  />

  {
    isVisual ? (
      <article class="guia-visual">
        <header class="guia-hero">
          <div class="container-aq guia-hero__grid">
            <div class="guia-hero__copy">
              <p class="eyebrow">Guía · {guia.brand}</p>
              {guia.brand && <p class="guia-hero__brand">{guia.brand}</p>}
              <h1 class="guia-hero__title">{guia.h1}</h1>
              {guia.lede && <p class="guia-hero__lede">{guia.lede}</p>}
              <div class="guia-hero__meta">
                <span>Publicado: {formatDate(guia.published)}</span>
                <span>Actualizado: {formatDate(guia.updated)}</span>
              </div>
              <div class="guia-hero__cta">
                <a href="/equipos/ized" class="btn-primary">Ver ficha iZED</a>
                <a href="/contacto" class="btn-secondary">Agendar demo</a>
              </div>
            </div>

            {
              guia.cover && (
                <figure class="guia-hero__figure">
                  <div class="guia-hero__glow" aria-hidden="true" />
                  <img
                    src={guia.cover.src}
                    alt={guia.cover.alt}
                    width="1200"
                    height="1200"
                    class="guia-hero__img"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                  {guia.cover.caption && (
                    <figcaption class="guia-hero__caption">{guia.cover.caption}</figcaption>
                  )}
                </figure>
              )
            }
          </div>
        </header>

        {
          guia.highlights && guia.highlights.length > 0 && (
            <section class="guia-highlights" aria-label="Datos clave">
              <div class="container-aq guia-highlights__grid">
                {guia.highlights.map((h) => (
                  <div class="guia-highlights__item">
                    <p class="label-mono">{h.label}</p>
                    <p class="guia-highlights__value">{h.value}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <div class="container-aq guia-visual__body">
          <div
            class="prose-aq guia-body guia-body--visual max-w-none text-[15px] sm:text-base [&_h2]:mt-12 [&_h2]:mb-4 [&_h3]:mt-8 [&_h3]:mb-3 [&_table]:my-8 [&_ul]:my-5 [&_ol]:my-5"
            set:html={body}
          />
        </div>

        {
          guia.gallery && guia.gallery.length > 0 && (
            <section class="guia-gallery" aria-labelledby="galeria-equipo">
              <div class="container-aq">
                <p class="eyebrow mb-2">Galería</p>
                <h2 id="galeria-equipo" class="mb-8">
                  La máquina, de cerca
                </h2>
                <div class="guia-gallery__grid">
                  {guia.gallery.map((img, i) => (
                    <figure class="guia-gallery__item">
                      <div class="guia-gallery__frame">
                        <img
                          src={img.src}
                          alt={img.alt}
                          width="900"
                          height="900"
                          loading="lazy"
                          decoding="async"
                          class="guia-gallery__img"
                        />
                      </div>
                      {img.caption && (
                        <figcaption class="guia-gallery__caption">
                          <span class="label-mono">FIG. 0{i + 1}</span>
                          <span>{img.caption}</span>
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </div>
            </section>
          )
        }

        <section class="guia-cta-band" aria-label="Cotizar equipo">
          <div class="container-aq guia-cta-band__inner">
            <div>
              <p class="eyebrow mb-2 !text-sky-200">Siguiente paso</p>
              <h2 class="guia-cta-band__title mb-3">
                Cotiza iZED con precio neto + IVA a la vista
              </h2>
              <p class="max-w-[52ch] text-sm text-white/75">
                Demo en showroom, ficha técnica y proyección de retorno. Sin specs inventadas.
              </p>
            </div>
            <div class="guia-cta-band__actions">
              <a href="/contacto" class="btn-cobalto">Agendar demo</a>
              <a
                href="/equipos/ized"
                class="btn-ghost !border-white/35 !text-blanco hover:!bg-white/10"
              >
                Ficha iZED
              </a>
            </div>
          </div>
        </section>

        {
          related.length > 0 && (
            <section class="container-aq py-14" aria-labelledby="rel-eq">
              <p class="eyebrow mb-2">Catálogo</p>
              <h2 id="rel-eq" class="mb-8">
                Equipos relacionados
              </h2>
              <div class="grid gap-5 sm:grid-cols-3">
                {related.map(
                  (e) =>
                    e && (
                      <a href={`/equipos/${e.slug}`} class="guia-related group no-underline">
                        {e.image ? (
                          <div class="guia-related__media">
                            <img
                              src={e.image}
                              alt=""
                              width="600"
                              height="600"
                              loading="lazy"
                              decoding="async"
                              class="guia-related__img"
                            />
                          </div>
                        ) : null}
                        <div class="guia-related__body">
                          <p class="label-mono mb-1">{e.category}</p>
                          <h3 class="!text-xl mb-2 group-hover:text-cobalto">{e.name}</h3>
                          <p class="font-mono text-sm text-cobalto">
                            {hasPrice(e.priceNeto)
                              ? `$${formatCLP(e.priceNeto)} neto`
                              : 'Consultar precio'}
                          </p>
                        </div>
                      </a>
                    )
                )}
              </div>
            </section>
          )
        }
      </article>
    ) : (
      <article class="container-aq pb-10 pt-4">
        <p class="eyebrow mb-2">Guía · Alta Qualità</p>
        <h1 class="mb-4 text-3xl sm:text-4xl leading-tight">{guia.h1}</h1>

        <div class="mb-8 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] uppercase tracking-[0.04em] text-acero">
          <span>Publicado: {formatDate(guia.published)}</span>
          <span>Última actualización: {formatDate(guia.updated)}</span>
          <span>
            Autor: {SITE.author.name || 'Equipo técnico Alta Qualità'}
            {SITE.author.credentials
              ? ` · ${SITE.author.credentials}`
              : ' · Importadora de equipos de estética (Chile)'}
          </span>
        </div>

        <div
          class="prose-aq guia-body max-w-none text-sm [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:mt-6 [&_h3]:mb-3 [&_table]:my-6 [&_ul]:my-4 [&_ol]:my-4"
          set:html={body}
        />

        {
          related.length > 0 && (
            <section class="mt-14 border-t border-linea pt-10" aria-labelledby="rel-eq">
              <h2 id="rel-eq" class="mb-6">
                Equipos relacionados
              </h2>
              <div class="grid gap-4 sm:grid-cols-3">
                {related.map(
                  (e) =>
                    e && (
                      <a
                        href={`/equipos/${e.slug}`}
                        class="card-line block p-4 no-underline hover:border-grafito"
                      >
                        <p class="label-mono mb-1">{e.category}</p>
                        <h3 class="!text-xl mb-2">{e.name}</h3>
                        <p class="font-mono text-sm text-cobalto">
                          {hasPrice(e.priceNeto)
                            ? `$${formatCLP(e.priceNeto)} neto`
                            : 'Consultar precio'}
                        </p>
                      </a>
                    )
                )}
              </div>
            </section>
          )
        }
      </article>
    )
  }

  <FAQ items={faqItems} />

  {
    !isVisual && (
      <section class="container-aq pb-16">
        <a href="/contacto" class="btn-primary">
          Agendar demo
        </a>
        <a href="/recursos" class="btn-ghost ml-3">
          Volver a recursos
        </a>
      </section>
    )
  }
</Layout>
