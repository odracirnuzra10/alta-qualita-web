---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import JsonLd from '../../components/JsonLd.astro';
import { guias, getGuia } from '../../lib/recursos';
import { guiaBodies } from '../../lib/guias-content';
import { getEquipo, formatCLP } from '../../lib/equipos';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return guias.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guia = getGuia(slug!);
if (!guia) throw new Error(`Guía no encontrada: ${slug}`);

const body = guiaBodies[guia.slug] || '<p>Contenido en preparación.</p>';
const related = guia.relatedEquipos.map((s) => getEquipo(s)).filter(Boolean);

function formatDate(iso: string) {
  return new Date(iso + 'T12:00:00').toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guia.title,
  description: guia.description,
  datePublished: guia.published,
  dateModified: guia.updated,
  inLanguage: 'es-CL',
  author: {
    '@type': 'Organization',
    name: SITE.name,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
  },
  mainEntityOfPage: `https://alta-qualita.cl/recursos/${guia.slug}`,
};
---

<Layout
  title={guia.title}
  description={guia.description}
  dateModified={guia.updated}
>
  <JsonLd data={articleLd} slot="head" />

  <Breadcrumbs
    items={[
      { name: 'Inicio', href: '/' },
      { name: 'Recursos', href: '/recursos' },
      { name: guia.title },
    ]}
  />

  <article class="container-aq pb-10 pt-4">
    <p class="eyebrow mb-2">Guía · Alta Qualità</p>
    <h1 class="mb-4 !normal-case !tracking-normal !font-sans !text-3xl sm:!text-4xl !leading-tight">
      {guia.h1}
    </h1>

    <div class="mb-8 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10px] uppercase tracking-[0.04em] text-acero">
      <span>Publicado: {formatDate(guia.published)}</span>
      <span>Última actualización: {formatDate(guia.updated)}</span>
      <span>
        Autor: {SITE.author.name || 'Equipo técnico Alta Qualità'}
        {SITE.author.credentials ? ` · ${SITE.author.credentials}` : ' · Importadora de equipos de estética (Chile)'}
      </span>
    </div>

    <div class="prose-aq guia-body max-w-none text-sm [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:mt-6 [&_h3]:mb-3 [&_table]:my-6 [&_ul]:my-4 [&_ol]:my-4" set:html={body} />

    {
      related.length > 0 && (
        <section class="mt-14 border-t border-linea pt-10" aria-labelledby="rel-eq">
          <h2 id="rel-eq" class="mb-6">Equipos relacionados</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {related.map(
              (e) =>
                e && (
                  <a href={`/equipos/${e.slug}`} class="card-line block p-4 no-underline hover:border-grafito">
                    <p class="label-mono mb-1">{e.category}</p>
                    <h3 class="!text-xl mb-2">{e.name}</h3>
                    <p class="font-mono text-sm text-cobalto">${formatCLP(e.priceNeto)} neto</p>
                  </a>
                )
            )}
          </div>
        </section>
      )
    }
  </article>

  <FAQ items={guia.faq} />

  <section class="container-aq pb-16">
    <a href="/contacto" class="btn-primary">Agendar demo</a>
    <a href="/recursos" class="btn-ghost ml-3">Volver a recursos</a>
  </section>
</Layout>
