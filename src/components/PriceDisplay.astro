---
import { priceParts } from '../lib/equipos';

interface Props {
  neto: number;
  class?: string;
}

const { neto, class: className = '' } = Astro.props;
const p = priceParts(neto);
---

<div class:list={['price-block', className]} itemscope itemtype="https://schema.org/Offer">
  <meta itemprop="priceCurrency" content="CLP" />
  <meta itemprop="price" content={String(neto)} />
  <p class="font-display text-3xl font-bold uppercase tracking-[-0.005em] text-grafito sm:text-4xl">
    {p.netoLabel}
  </p>
  <p class="mt-1 font-mono text-xs tracking-[0.04em] text-acero" style="font-variant-numeric: tabular-nums;">
    {p.ivaLabel}
    <span class="mx-1.5 text-linea">·</span>
    {p.totalLabel}
  </p>
</div>
