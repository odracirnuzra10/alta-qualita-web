---
import { SITE } from '../lib/site';

interface Props {
  class?: string;
  dense?: boolean;
}

const { class: className = '', dense = false } = Astro.props;
---

<div class:list={['grid gap-3', dense ? 'sm:grid-cols-1' : 'sm:grid-cols-3', className]}>
  {
    SITE.showrooms.map((s) => (
      <address class="card-line not-italic p-4">
        <p class="label-mono mb-2">{s.label}</p>
        <p class="font-display text-lg font-semibold text-grafito tracking-[-0.015em]">{s.city}</p>
        <p class="mt-1 text-sm text-texto">{s.street}</p>
        <p class="mt-1 text-xs text-acero">{s.region}, Chile</p>
      </address>
    ))
  }
</div>
