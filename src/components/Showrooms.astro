---
import { SITE } from '../lib/site';

interface Props {
  class?: string;
  dense?: boolean;
}

const { class: className = '', dense = false } = Astro.props;
---

<div class:list={['showrooms-grid grid gap-3', dense ? 'sm:grid-cols-1' : 'sm:grid-cols-3', className]}>
  {
    SITE.showrooms.map((s) => (
      <address class="card-line showrooms-card not-italic">
        <p class="label-mono mb-2">{s.label}</p>
        <p class="font-display text-lg font-semibold tracking-[-0.015em] text-grafito">{s.city}</p>
        <p class="mt-1 text-sm text-texto">{s.street}</p>
        <p class="mt-1 text-xs text-acero">{s.region}, Chile</p>
      </address>
    ))
  }
</div>

<style>
  .showrooms-card {
    padding: 1.1rem 1.15rem;
  }
</style>
