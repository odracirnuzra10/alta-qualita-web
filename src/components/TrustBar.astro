---
import { SITE } from '../lib/site';
import Pending from './Pending.astro';

const g = SITE.trustBar.garantiaMeses;
const s = SITE.trustBar.soporteHoras;
---

<aside
  class="border-b border-linea bg-papel"
  aria-label="Barra de confianza"
>
  <div class="container-aq flex flex-wrap items-center justify-center gap-x-4 gap-y-1 py-2 text-center font-mono text-[10px] uppercase tracking-[0.04em] text-acero sm:justify-between sm:text-left">
    <span class="inline-flex items-center gap-1">
      GARANTÍA —
      {g ? <span class="text-grafito">{g} MESES</span> : <Pending class="!min-h-0 !py-0.5" label="Meses de garantía por confirmar" />}
    </span>
    <span class="hidden text-linea sm:inline" aria-hidden="true">·</span>
    <span>{SITE.trustBar.repuestos}</span>
    <span class="hidden text-linea sm:inline" aria-hidden="true">·</span>
    <span class="inline-flex items-center gap-1">
      SOPORTE EN —
      {s ? <span class="text-grafito">{s} H</span> : <Pending class="!min-h-0 !py-0.5" label="SLA de soporte por confirmar" />}
    </span>
    <span class="hidden text-linea sm:inline" aria-hidden="true">·</span>
    <span>{SITE.trustBar.capacitacion}</span>
  </div>
</aside>
