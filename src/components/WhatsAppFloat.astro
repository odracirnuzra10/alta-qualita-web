---
import { SITE } from '../lib/site';
import { whatsappUrl } from '../lib/equipos';

const page = Astro.url.pathname;
const msg = `Hola Alta Qualità, escribo desde ${page} y quiero agendar una demo / cotización.`;
const href = whatsappUrl(msg);
---

{
  SITE.whatsapp && href ? (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-4 right-4 z-50 flex items-center gap-2 border border-linea bg-grafito px-4 py-3 text-sm font-medium text-blanco md:bottom-6 md:right-6"
      data-whatsapp-float
      aria-label="Escribir por WhatsApp"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.5 3.5A11 11 0 0 0 3.4 17.7L2 22l4.4-1.4A11 11 0 1 0 20.5 3.5zm-8.5 17a9 9 0 0 1-4.6-1.3l-.3-.2-2.6.8.8-2.5-.2-.3a9 9 0 1 1 6.9 3.5zm5-6.7c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.4 7.4 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.3-.4c.1-.2 0-.3 0-.5l-.9-2.1c-.2-.6-.5-.5-.6-.5h-.5c-.2 0-.5.1-.7.4s-1 1-1 2.4 1 2.8 1.2 3 .2.3 2 3.1c1.7 1.5 2.2 1.7 2.9 2 .4.1.8.1 1.1.1.3 0 1-.4 1.2-.8s.4-.7.3-.9-.2-.2-.5-.3z" />
      </svg>
      WhatsApp
    </a>
  ) : (
    <a
      href="/contacto"
      class="fixed bottom-4 right-4 z-50 border border-linea bg-grafito px-4 py-3 text-sm font-medium text-blanco md:bottom-6 md:right-6 md:hidden"
      aria-label="Contactar"
    >
      Contactar
    </a>
  )
}

<script>
  document.querySelector('[data-whatsapp-float]')?.addEventListener('click', () => {
    // @ts-expect-error gtag optional
    if (typeof window.gtag === 'function') {
      // @ts-expect-error gtag optional
      window.gtag('event', 'click_whatsapp', { page_path: location.pathname });
    }
  });
</script>
