---
/**
 * Tarjeta de catálogo. variant "stock": grande, con CTA secundario de WhatsApp.
 * variant "pedido": compacta, sin CTA secundario.
 * El enlace principal cubre toda la tarjeta (stretched link); el CTA de WhatsApp queda por encima.
 */
import AvailabilityBadge from './AvailabilityBadge.astro';
import { formatCLP, priceParts, hasPrice, equipoHref, whatsappUrl, type Equipo } from '../lib/equipos';

interface Props {
  equipo: Equipo;
  variant: 'stock' | 'pedido';
}

const { equipo: e, variant } = Astro.props;
const stock = variant === 'stock';
const priced = hasPrice(e.priceNeto);
const p = priced ? priceParts(e.priceNeto) : null;
const href = equipoHref(e.slug);
const wa = stock ? whatsappUrl(`Hola Alta Qualità, quiero cotizar el ${e.name}.`) : null;
---

{
  stock ? (
    <article class="card-line group relative flex flex-col overflow-hidden !p-0 transition-colors hover:border-grafito">
      <div class="relative">
        {e.image ? (
          <img src={e.image} alt="" width="600" height="600" class="aspect-square w-full bg-papel object-cover" loading="lazy" decoding="async" />
        ) : (
          <div class="aspect-square w-full bg-papel" />
        )}
        <AvailabilityBadge disponibilidad="inmediata" class="absolute left-3 top-3" />
      </div>
      <div class="flex flex-1 flex-col p-5">
        <p class="label-mono mb-2">{e.category}</p>
        <h3 class="mb-3 text-2xl group-hover:text-cobalto">
          <a href={href} class="no-underline after:absolute after:inset-0 after:content-['']">{e.name}</a>
        </h3>
        <p class="font-display text-2xl font-semibold tracking-[-0.02em] text-grafito" style="font-variant-numeric: tabular-nums;">
          {priced ? `$${formatCLP(e.priceNeto)} neto` : 'Consultar precio'}
        </p>
        <p class="mt-1 font-mono text-[10px] tracking-[0.04em] text-acero">
          {p ? `${p.ivaLabel} · ${p.totalLabel}` : 'Precio a cotizar'}
        </p>
        <p class="mt-4 text-sm font-semibold text-cobalto">Ver ficha →</p>
        {wa ? (
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary relative z-10 mt-4 !py-2 text-center"
            data-track-wa={e.slug}
          >
            Cotizar por WhatsApp
          </a>
        ) : null}
      </div>
    </article>
  ) : (
    <article class="card-line group relative flex flex-row items-stretch gap-3 overflow-hidden !p-0 transition-colors hover:border-grafito max-sm:flex-col max-sm:gap-0 sm:max-lg:flex-col sm:max-lg:gap-0">
      <div class="relative shrink-0 bg-papel lg:w-28">
        {e.image ? (
          <img src={e.image} alt="" width="300" height="300" class="aspect-[4/3] w-full object-contain p-2 lg:aspect-square lg:h-full" loading="lazy" decoding="async" />
        ) : (
          <div class="aspect-[4/3] w-full lg:aspect-square" />
        )}
        <AvailabilityBadge disponibilidad="pedido" size="sm" class="absolute left-2 top-2" />
      </div>
      <div class="flex min-w-0 flex-1 flex-col justify-center p-3">
        <p class="label-mono mb-1 truncate">{e.category}</p>
        <h3 class="mb-1 !text-base group-hover:text-cobalto">
          <a href={href} class="no-underline after:absolute after:inset-0 after:content-['']">{e.name}</a>
        </h3>
        <p class="font-mono text-xs font-medium text-grafito" style="font-variant-numeric: tabular-nums;">
          {priced ? `$${formatCLP(e.priceNeto)} neto` : 'Consultar precio'}
        </p>
        <p class="mt-2 text-xs font-semibold text-cobalto">Ver ficha →</p>
      </div>
    </article>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-track-wa]').forEach((el) => {
    el.addEventListener('click', () => {
      // @ts-expect-error gtag opcional
      if (typeof window.gtag === 'function') window.gtag('event', 'click_whatsapp', { equipo: el.dataset.trackWa, page_path: location.pathname });
    });
  });
</script>
