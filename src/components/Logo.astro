---
interface Props {
  compact?: boolean;
  light?: boolean;
}

const { compact = false, light = false } = Astro.props;
const text = light ? 'text-blanco' : 'text-grafito';
const sub = light ? 'text-white/70' : 'text-acero';
---

<a href="/" class={`inline-flex items-center gap-2 no-underline ${text}`} aria-label="Alta Qualità — inicio">
  {compact ? (
    <span class="inline-flex items-center gap-1.5">
      <span class="block h-7 w-1 bg-cobalto" aria-hidden="true"></span>
      <span class="flex h-7 w-7 items-center justify-center bg-grafito font-display text-sm font-semibold tracking-tight text-blanco">AQ</span>
    </span>
  ) : (
    <>
      <span class="block h-9 w-1 shrink-0 bg-cobalto" aria-hidden="true"></span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[22px] font-semibold tracking-[-0.02em]">Alta Qualità</span>
        <span class={`mt-1 font-mono text-[9px] uppercase tracking-[0.06em] ${sub}`}>Equipos de estética</span>
      </span>
    </>
  )}
</a>
