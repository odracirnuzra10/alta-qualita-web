---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  title?: string;
  id?: string;
}

const { items, title = 'Preguntas frecuentes', id = 'faq' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="py-16" id={id} aria-labelledby={`${id}-title`}>
  <div class="container-aq">
    <h2 id={`${id}-title`} class="mb-8">{title}</h2>
    <div class="divide-y divide-linea border-y border-linea">
      {
        items.map((item) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none font-sans text-base font-semibold text-grafito marker:content-none">
              <span class="flex items-start justify-between gap-4">
                <span>{item.q}</span>
                <span class="font-mono text-cobalto transition group-open:rotate-45" aria-hidden="true">+</span>
              </span>
            </summary>
            <p class="prose-aq mt-3 text-sm text-texto">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
