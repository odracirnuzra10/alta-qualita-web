---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import TrustBar from '../components/TrustBar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../lib/site';
import { absoluteUrl } from '../lib/equipos';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  dateModified?: string;
}

const {
  title,
  description,
  ogImage = '/og/default.svg',
  canonical,
  noindex = false,
  dateModified = `${SITE.lastUpdated}-01`,
} = Astro.props;

const pageTitle = title.includes('Alta Qualità') ? title : `${title} | Alta Qualità`;
const canonicalUrl = canonical ? absoluteUrl(canonical) : new URL(Astro.url.pathname, SITE.domain).href.replace(/\/$/, '') || SITE.domain;
const ogAbs = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.domain,
  logo: absoluteUrl('/favicon.svg'),
  description: SITE.description,
  areaServed: 'CL',
  ...(SITE.email ? { email: SITE.email } : {}),
  ...(SITE.phone ? { telephone: SITE.phone } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  location: SITE.showrooms.map((s) => ({
    '@type': 'Place',
    name: s.label,
    address: {
      '@type': 'PostalAddress',
      streetAddress: s.street,
      addressLocality: s.city,
      addressRegion: s.region,
      addressCountry: 'CL',
    },
  })),
  sameAs: [SITE.social.instagram, SITE.social.linkedin, SITE.social.facebook].filter(Boolean),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
  inLanguage: 'es-CL',
  dateModified,
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl === SITE.domain ? SITE.domain : canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#14171A" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Alta Qualità" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&family=Source+Code+Pro:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    {
      SITE.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
          <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4Id);
          </script>
        </>
      )
    }

    <JsonLd data={[orgLd, websiteLd]} />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-cobalto focus:px-3 focus:py-2 focus:text-blanco">
      Saltar al contenido
    </a>
    <Nav />
    <TrustBar />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
